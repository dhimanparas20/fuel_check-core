# Django Settings
# Generate a new secret key for production: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-insecure-change-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app

# ---------------------------------------------------------------------------- #
# Database Configuration
# ---------------------------------------------------------------------------- #
# Set USE_REMOTE_DB=True to use PostgreSQL/cloud database
# Set USE_REMOTE_DB=False (or leave unset) to use local SQLite
USE_REMOTE_DB=False

# Remote PostgreSQL credentials (required only when USE_REMOTE_DB=True)
DB_NAME=postgres
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=your-db-host.example.com
DB_PORT=5432

# AWS S3 Configuration (Optional - for static/media hosting)
# True  → STATIC_URL / MEDIA_URL point at S3 (requires AWS_* below)
# False → STATIC_URL=/static/ (local/Docker: WhiteNoise; Vercel: static/ via @vercel/static in vercel.json)
USE_AWS_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ---------------------------------------------------------------------------- #
# System Page Auth (HTTP Basic Auth for /system/ route)
# ---------------------------------------------------------------------------- #
STATUS_USER=admin
STATUS_PASS=status123
