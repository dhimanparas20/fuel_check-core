# Django Settings
# Generate a new secret key for production: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-insecure-change-this-in-production

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app

# Database Configuration - Supabase PostgreSQL
# Get these from your Supabase dashboard > Settings > Database
DB_NAME=postgres
DB_USER=your-supabase-user
DB_PASSWORD=your-supabase-password
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=6543

# Alternative: Full Database URL (if using dj-database-url)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# AWS S3 Configuration (Optional - for static file hosting)
# Set to True to use AWS S3 for static files
USE_AWS_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
